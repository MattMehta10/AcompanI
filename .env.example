# Provider: "openai_compatible" (0 MB disk — OpenRouter/Groq/Gemini/OpenAI) | "ollama" | "mock"
LLM_PROVIDER=openai_compatible

# --- Option A: OpenRouter (supports Llama 3.1, Llama 3.3, Claude, Gemini, GPT-4o) ---
OPENAI_API_KEY=sk-or-v1-your_key_here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_ROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
DEFAULT_WORKER_MODEL=meta-llama/llama-3.3-70b-instruct

# --- Option B: Free Groq API (0 MB disk) ---
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# DEFAULT_ROUTER_MODEL=llama-3.1-8b-instant
# DEFAULT_WORKER_MODEL=llama-3.3-70b-versatile

# --- Option C: Free Google Gemini API (OpenAI-compatible endpoint, 0 MB disk) ---
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# DEFAULT_ROUTER_MODEL=gemini-2.5-flash-lite
# DEFAULT_WORKER_MODEL=gemini-2.5-flash

# --- Option C: Local Ollama (requires ~3-5 GB free disk) ---
OLLAMA_BASE_URL=http://localhost:11434

# Embeddings: "chroma_default" (already cached locally, ~79 MB) or "ollama"
EMBEDDING_PROVIDER=chroma_default
