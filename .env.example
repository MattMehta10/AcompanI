# Provider: "openai_compatible" (0 MB disk — Groq/Gemini/OpenAI) | "ollama" | "mock"
LLM_PROVIDER=openai_compatible

# --- Option A: Free Groq API (0 MB disk, recommended for low disk space) ---
OPENAI_API_KEY=your_groq_or_gemini_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
DEFAULT_ROUTER_MODEL=llama-3.1-8b-instant
DEFAULT_WORKER_MODEL=llama-3.3-70b-versatile

# --- Option B: Free Google Gemini API (OpenAI-compatible endpoint, 0 MB disk) ---
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# DEFAULT_ROUTER_MODEL=gemini-2.5-flash-lite
# DEFAULT_WORKER_MODEL=gemini-2.5-flash

# --- Option C: Local Ollama (requires ~3-5 GB free disk) ---
OLLAMA_BASE_URL=http://localhost:11434

# Embeddings: "chroma_default" (already cached locally, ~79 MB) or "ollama"
EMBEDDING_PROVIDER=chroma_default
